# Written by /tradie-cc:setup. Do not paste secrets in here: they go in
# `wrangler secret put`, which stores them encrypted on Cloudflare.
#
#   DASH_PASSWORD   the login password for the dashboard
#   COOKIE_SECRET   random key that signs the session cookie
#   INGEST_SECRET   bearer token the routines use to POST results
name = "__WORKER_NAME__"
main = "worker.js"
compatibility_date = "2026-01-01"

[vars]
BUSINESS_NAME = "__BUSINESS_NAME__"
TIMEZONE = "__TIMEZONE__"
CURRENCY = "__CURRENCY__"

[[d1_databases]]
binding = "DB"
database_name = "__DB_NAME__"
database_id = "__DB_ID__"

# The question box on the Ask tab. Workers AI runs on this same Cloudflare account and is
# free on the plan everything else here already uses, so there is nothing extra to sign up
# for and nothing extra to pay.
#
# To upgrade the answers later, and only then does it cost anything:
#   npx wrangler secret put ANTHROPIC_API_KEY
#   npx wrangler secret put ASK_MODEL        -> claude-sonnet-5
# remote = true because an AI binding is unsupported in local dev without it: the demo
# would show a broken question box, which is the one part people most want to try.
[ai]
binding = "AI"
remote = true
